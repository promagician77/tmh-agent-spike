{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ]},
    { "source": "/src/(.*)", "headers": [ { "key": "Content-Type", "value": "text/javascript; charset=utf-8" } ] }
  ]
}
